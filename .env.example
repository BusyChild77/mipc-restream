# Copy to `.env` and fill in. `.env` is gitignored; keep it that way.

# The MIPC account, the same one the phone app signs in with.
#
# A `$` in the password must be written `$$`. Compose reads this file for its
# own variable substitution first, so a lone `$` starts a reference to a
# variable that does not exist and everything from it onwards is dropped. The
# password then fails authentication while looking correct in this file.
MIPC_USERNAME=owner@example.com
MIPC_PASSWORD=change-me

# Which encoding to pull from the camera. p0 is the largest and p1..p3 are
# progressively smaller. The video crosses the internet once to reach the NAS
# and is then served locally, so p1 or p2 is often the honest choice on a
# domestic uplink.
MIPC_STREAM_PROFILE=p0

# Restrict which cameras are published, as a comma separated list of serials.
# Leave empty to publish every camera on the account. `mipc-restream discover`
# prints the serials.
#
# Note that MIPC_USERNAME may be a camera's own serial rather than an email
# address — that is what the app offers as sharing a device. On such an account
# `accounts.user.offline` means that camera is not connected to MIPC's cloud,
# never that the password is wrong; see "What to expect" in the README.
MIPC_SERIALS=

# Ports go2rtc listens on inside the container. Change the compose `ports:`
# block to move them on the host.
MIPC_RTSP_PORT=8554
MIPC_API_PORT=1984
MIPC_WEBRTC_PORT=8555

# What to do about the camera's audio: silent, camera, or none.
#
# MIPC delivers its AAC track slowly enough that ffmpeg's stream probe blocks on
# it, and nothing but the read timeout below ever ends the wait. That is what
# made every connection take as long as the timeout, and what forced the timeout
# to be too short to survive an ordinary hiccup on the uplink.
#
#   silent  refuse MIPC's audio and publish a synthesised silent track instead.
#           Fast to start, and an NVR set to record sound still works: it asks
#           ffmpeg for `-map 0:a` and finds a track there.
#   camera  MIPC's real audio. Costs about seven seconds on every connection,
#           and makes MIPC_READ_TIMEOUT the startup delay again.
#   none    no audio track at all. Fastest, but an NVR set to record sound
#           fails with "Stream map '0:a' matches no streams" and never starts.
MIPC_AUDIO=silent

# What ffmpeg does with the streams. Leave it empty to get the right default for
# the audio mode above — which for `silent` includes the mapping that keeps the
# silent track attached. Setting this replaces that default outright rather than
# adding to it, so an override in `silent` mode has to do its own `-map`.
# Anything other than copying means the NAS re-encodes, which is rarely wanted.
MIPC_FFMPEG_ARGS=

# Seconds ffmpeg waits on a silent upstream before giving up on it.
#
# This is a watchdog, not a startup cost — refusing the audio track above is
# what separated the two. Thirty seconds is deliberately patient: the video
# crosses the internet, and a relay that stalls for six seconds is having a bad
# moment rather than dying. Giving up costs a fresh MIPC login, a fresh URL and
# a gap the recorder shows as a black screen, so it is worth waiting out.
#
# Lower it only if you would rather reconnect early than sit on a dead stream.
# With MIPC_AUDIO=camera it is the startup delay as well, so keep it small there.
#
# It watches the socket and nothing else. MIPC's relay keeps answering ffmpeg's
# keepalives after the camera behind it has stopped sending, so a camera that
# simply goes quiet never trips this. MIPC_STALL_TIMEOUT is the one that does.
MIPC_READ_TIMEOUT=30

# Seconds without a delivered packet before the stream is restarted.
#
# This is the watchdog that catches the failure that matters: a camera that
# stops sending while the connection stays up. ffmpeg is asked for a progress
# report and the counters in it are read; when none of them has moved for this
# long, ffmpeg is stopped and go2rtc mints a fresh session on the next connect.
#
# Keep it at 11 or below. go2rtc ends a stream whose producer has sent it
# nothing for fifteen seconds, and it does that by SIGKILLing the process that
# supervises ffmpeg — which is how an ffmpeg gets left behind holding a MIPC
# session, and how a camera ends up refusing every new one until it is power
# cycled. ffmpeg is given three seconds to close its session on top of this, so
# both halves have to fit inside those fifteen.
MIPC_STALL_TIMEOUT=10

# How many times the entrypoint asks MIPC what the account holds before it
# starts go2rtc anyway, and how long it leaves between asking.
#
# It only has to ask once ever: the listing is remembered in the config volume,
# and every later start regenerates go2rtc.yaml from that record with the code
# running now. Retrying here is for the first start of all, and for a link that
# comes up after the NAS does.
MIPC_CONFIG_ATTEMPTS=3
MIPC_CONFIG_RETRY_DELAY=10

# trace, debug, info, warn, error
MIPC_LOG_LEVEL=info
