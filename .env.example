# Copy to `.env` and fill in. `.env` is gitignored; keep it that way.

# The MIPC account, the same one the phone app signs in with.
MIPC_USERNAME=owner@example.com
MIPC_PASSWORD=change-me

# Which encoding to pull from the camera. p0 is the largest and p1..p3 are
# progressively smaller. The video crosses the internet once to reach the NAS
# and is then served locally, so p1 or p2 is often the honest choice on a
# domestic uplink.
MIPC_STREAM_PROFILE=p0

# Restrict which cameras are published, as a comma separated list of serials.
# Leave empty to publish every camera on the account. `mipc-restream discover`
# prints the serials.
MIPC_SERIALS=

# Ports go2rtc listens on inside the container. Change the compose `ports:`
# block to move them on the host.
MIPC_RTSP_PORT=8554
MIPC_API_PORT=1984
MIPC_WEBRTC_PORT=8555

# What ffmpeg does with the video. The default copies it; anything else means
# the NAS re-encodes, which is rarely what you want.
MIPC_FFMPEG_ARGS=-c copy

# trace, debug, info, warn, error
MIPC_LOG_LEVEL=info
